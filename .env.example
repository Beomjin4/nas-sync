# Copy to .env and customize. Never commit .env.
#
# Generate strong secrets, e.g.:
#   ONS_JWT_SECRET=$(openssl rand -hex 48)
#   ONS_PAIRING_CODE=$(openssl rand -hex 8)

# Used to sign device JWTs. If you ever change this, every paired device
# loses its token and must re-pair.
ONS_JWT_SECRET=replace-with-a-long-random-secret

# Pre-shared secret required to pair a new device. Treat it like a password
# and share over a trusted channel (e.g. read it off the NAS terminal). If
# you comment this out the server refuses all pairing attempts.
ONS_PAIRING_CODE=set-a-shared-secret-here

# Password for the /admin web console (activity log, trash restore,
# conflict resolution, device management). Leave unset to disable it.
ONS_ADMIN_PASSWORD=set-an-admin-password

